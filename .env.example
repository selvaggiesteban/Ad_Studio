# Ad Studio Environment Configuration
# Copy this file to .env and fill in your credentials

# NVIDIA API Key for FLUX models
NVIDIA_API_KEY=your_nvidia_api_key_here

# Path to MoneyPrinterTurbo repository (Absolute path)
# Example (Windows): C:/Users/Name/Documents/MoneyPrinterTurbo
# Example (Linux/Mac): /home/name/MoneyPrinterTurbo
MONEY_PRINTER_TURBO_PATH=
